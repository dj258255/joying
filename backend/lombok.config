# Lombok 설정
#
# 여기서 멈춘다. 위 디렉터리의 설정을 더 찾지 않는다.
config.stopBubbling = true

# 필드에 붙인 애너테이션을 생성자 파라미터로 옮긴다.
#
# @RequiredArgsConstructor 는 필드 애너테이션을 파라미터로 자동으로 옮기지 않는다.
# 필드에 붙은 것이 파라미터에도 뜻이 통한다는 보장이 없어서다. 옮길 것을 여기에
# 적어야 한다.
#
# 이것이 없으면 같은 타입의 빈이 둘 이상일 때 @Qualifier 가 사라져 어느 것인지
# 고르지 못하고 기동에 실패한다. 실제로 실행기를 둘로 나누는 순간 그렇게 됐다.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
