## 🔧 코드 작성 규칙

### 1. Import 순서 (자동 정렬)
```javascript
// 1. 외부 라이브러리
import React, { useState, useEffect } from 'react';
import { useQuery } from '@tanstack/react-query';
import axios from 'axios';

// 2. 절대 경로 (@/)
import { Button } from '@/shared/components';
import { useAuth } from '@/features/auth';
import { API_ENDPOINTS } from '@/shared/constants';

// 3. 상대 경로
import { ProductCard } from './ProductCard';
import { useProducts } from '../hooks/useProducts';
import styles from './ProductList.module.css';
```

### 2. 컴포넌트 구조 템플릿
```javascript
import React, { useState } from 'react';
import PropTypes from 'prop-types';

/**
 * 제품 카드 컴포넌트
 * @param {Object} props
 * @param {string} props.productId - 제품 ID
 * @param {Function} props.onLike - 찜하기 콜백
 */
const ProductCard = ({ productId, onLike }) => {
  // 1. State
  const [isLiked, setIsLiked] = useState(false);

  // 2. Hooks
  const { data: product, isLoading } = useProduct(productId);

  // 3. Handlers
  const handleLikeClick = () => {
    setIsLiked(!isLiked);
    onLike?.(productId);
  };

  // 4. Effects
  useEffect(() => {
    console.log('Product loaded:', product);
  }, [product]);

  // 5. Early returns
  if (isLoading) return <Loading />;
  if (!product) return <div>상품을 찾을 수 없습니다</div>;

  // 6. Render
  return (
    <div className="product-card">
      <h3>{product.name}</h3>
      <button onClick={handleLikeClick}>
        {isLiked ? '찜 취소' : '찜하기'}
      </button>
    </div>
  );
};

// PropTypes 정의
ProductCard.propTypes = {
  productId: PropTypes.string.isRequired,
  onLike: PropTypes.func
};

// Default props
ProductCard.defaultProps = {
  onLike: undefined
};

export default ProductCard;
```

### 3. API 작성 규칙
```javascript
// features/product/api/productApi.js
import { axiosInstance } from '@/lib/axios';

/**
 * 제품 관련 API
 */
export const productApi = {
  /**
   * 제품 목록 조회
   * @param {Object} params - 쿼리 파라미터
   * @param {number} params.page - 페이지 번호
   * @param {number} params.limit - 페이지 크기
   * @returns {Promise<{items: Array, total: number}>}
   */
  getProducts: async (params) => {
    const { data } = await axiosInstance.get('/products', { params });
    return data;
  },

  /**
   * 제품 상세 조회
   * @param {string} id - 제품 ID
   * @returns {Promise<Object>}
   */
  getProductById: async (id) => {
    const { data } = await axiosInstance.get(`/products/${id}`);
    return data;
  },

  /**
   * 제품 생성
   * @param {Object} productData - 제품 정보
   * @returns {Promise<Object>}
   */
  createProduct: async (productData) => {
    const { data } = await axiosInstance.post('/products', productData);
    return data;
  },

  /**
   * 제품 수정
   * @param {string} id - 제품 ID
   * @param {Object} productData - 수정할 정보
   * @returns {Promise<Object>}
   */
  updateProduct: async (id, productData) => {
    const { data } = await axiosInstance.put(`/products/${id}`, productData);
    return data;
  },

  /**
   * 제품 삭제
   * @param {string} id - 제품 ID
   * @returns {Promise<void>}
   */
  deleteProduct: async (id) => {
    await axiosInstance.delete(`/products/${id}`);
  }
};
```

### 4. React Query Hook 패턴
```javascript
// features/product/hooks/useProducts.js
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { productApi } from '../api/productApi';
import { QUERY_KEYS } from '@/lib/react-query/queryKeys';

/**
 * 제품 목록 조회 훅
 * @param {Object} filters - 필터 옵션
 * @returns {Object} Query 결과
 */
export const useProducts = (filters = {}) => {
  return useQuery({
    queryKey: [QUERY_KEYS.PRODUCTS, filters],
    queryFn: () => productApi.getProducts(filters),
    staleTime: 1000 * 60 * 5, // 5분
    gcTime: 1000 * 60 * 10,   // 10분
    retry: 1
  });
};

/**
 * 제품 생성 Mutation 훅
 * @returns {Object} Mutation 결과
 */
export const useCreateProduct = () => {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: productApi.createProduct,
    onSuccess: () => {
      // 캐시 무효화
      queryClient.invalidateQueries({ 
        queryKey: [QUERY_KEYS.PRODUCTS] 
      });
    },
    onError: (error) => {
      console.error('상품 등록 실패:', error);
    }
  });
};
```

### 5. Custom Hook 패턴
```javascript
// shared/hooks/useDebounce.js
import { useState, useEffect } from 'react';

/**
 * 디바운스 훅
 * @param {any} value - 디바운스할 값
 * @param {number} delay - 지연 시간 (ms)
 * @returns {any} 디바운스된 값
 */
export const useDebounce = (value, delay = 500) => {
  const [debouncedValue, setDebouncedValue] = useState(value);

  useEffect(() => {
    const timer = setTimeout(() => {
      setDebouncedValue(value);
    }, delay);

    return () => clearTimeout(timer);
  }, [value, delay]);

  return debouncedValue;
};
```

