# -------------------------------------
# 개발 환경 변수 (.env.development)
# npm run dev 실행 시 자동으로 로드됨
# -------------------------------------

# API Base URL (Axios에서 사용)
# Vite 프록시를 사용하므로 상대 경로로 설정
# /api/v1까지 포함 (백엔드 모든 엔드포인트가 /api/v1로 시작)
VITE_API_BASE_URL=/api/v1

# WebSocket URL (개발 환경)
# Vite 프록시를 사용하므로 상대 경로로 설정
# ws://localhost:5173/ws/chat → Vite 프록시 → ws://localhost:8080/ws/chat
VITE_WS_URL=/ws/chat

# 백엔드 프록시 타겟 (Vite 개발 서버 전용)
# 로컬 백엔드 테스트: http://localhost:8080
# 실서버 백엔드 테스트: https://k13c202.p.ssafy.io
VITE_BACKEND_TARGET=http://localhost:8080

# Mock 데이터 사용 여부
VITE_USE_MOCK=false

# 환경 구분
VITE_ENV=development

VITE_TOSS_CLIENT_KEY=test_ck_0RnYX2w532YajLyMXKA18NeyqApQ
