## 📊 상수 관리

### API 엔드포인트
```javascript
// shared/constants/apiEndpoints.js
export const API_ENDPOINTS = {
  AUTH: {
    LOGIN: '/auth/login',
    LOGOUT: '/auth/logout',
    REFRESH: '/auth/refresh'
  },
  PRODUCTS: {
    LIST: '/products',
    DETAIL: (id) => `/products/${id}`,
    CREATE: '/products',
    UPDATE: (id) => `/products/${id}`,
    DELETE: (id) => `/products/${id}`,
    LIKE: (id) => `/products/${id}/like`
  },
  USERS: {
    PROFILE: '/users/me',
    UPDATE: '/users/me',
    DELETE: '/users/me'
  }
};
```

