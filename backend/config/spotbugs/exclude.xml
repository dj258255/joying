<?xml version="1.0" encoding="UTF-8"?>
<!--
  정적 분석에서 뺄 자리.

  여기 적는 것은 "고치지 않기로 한 것"이 아니라 "이 도구가 이 코드에서는 틀리게
  보는 것"이다. 고칠 것을 여기 넣어 숨기면 도구를 붙인 뜻이 없어진다.
-->
<FindBugsFilter>

    <!--
      Lombok 이 만든 것은 우리가 쓴 것이 아니다.

      @Data 나 @Getter 가 만든 접근자는 안에 있는 객체를 그대로 내주므로 EI_EXPOSE_REP
      가 붙는다. 엔티티마다 붙어 수백 건이 되는데, 고치려면 Lombok 을 걷어내야 한다.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      DTO 는 값을 담아 나르는 자리다. 분기가 없어 커버리지에서 뺀 것과 같은 이유로
      여기서도 뺀다.
    -->
    <Match>
        <Package name="~.*\.dto.*"/>
    </Match>

    <!--
      스프링이 만들어 넣는 자리. 필드를 우리가 채우지 않으므로 도구는 null 로 본다.
    -->
    <Match>
        <Bug pattern="NP_UNWRITTEN_FIELD,UWF_UNWRITTEN_FIELD"/>
        <Package name="~.*\.config.*"/>
    </Match>

</FindBugsFilter>
