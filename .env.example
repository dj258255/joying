# 로컬에서 앱을 띄울 때 쓰는 값.
#
# 이 파일을 복사해 .env 로 만들고 값을 채운다. .env 는 저장소에 올리지 않는다.
#
#   cp .env.example .env
#
# 운영 값은 여기에 없다. 서버에서는 Ansible 이 vault 에서 꺼내 만든다
# (ansible/README.md).
#
# ---------------------------------------------------------------------------
# 비밀 — 사람마다 다르고 저장소에 올리지 않는다
# ---------------------------------------------------------------------------

# 최소 32바이트. 짧으면 기동할 때 막힌다
JWT_SECRET=local-dev-secret-please-change-me-32bytes

POSTGRES_PASSWORD=joying
REDIS_PASSWORD=joying_redis_password
ELASTIC_PASSWORD=changeme

# 카카오 로그인. 없으면 소셜 로그인만 안 되고 나머지는 뜬다
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 토스페이먼츠 테스트 키
TOSS_SECRET_KEY=test_sk_replace_me

# 파일 저장소
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=

# 웹 푸시. WEB_PUSH_ENABLED=false 면 안 쓴다
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# 금융망. 실 API 가 사라져 기본이 꺼져 있다(JOYING_MONEY_TRANSFER=wallet)
SSAFY_FINANCE_API_KEY=
SSAFY_ESCROW_ACCOUNT_NO=
SSAFY_ESCROW_USER_KEY=

# ---------------------------------------------------------------------------
# 접속 정보 — docker-compose-local.yml 과 짝이 맞아야 한다
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DATABASE=project_db
POSTGRES_USERNAME=joying

REDIS_HOST=localhost
REDIS_PORT=16379

ELASTIC_HOST=localhost

# ---------------------------------------------------------------------------
# 동작을 바꾸는 값 — 비밀이 아니다
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

# 돈을 옮기는 구현을 고른다. 금융망 API 가 사라져 기본은 전자지갑이다
JOYING_MONEY_TRANSFER=wallet

# 로컬은 https 가 아니라 쿠키에 secure 를 걸면 로그인이 안 된다
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

WEB_PUSH_ENABLED=false
